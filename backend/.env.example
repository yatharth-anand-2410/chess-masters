GEMINI_API_KEY=your-gemini-api-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-here
FRONTEND_ORIGIN=https://your-vercel-app.vercel.app
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_PLAN_ID=plan_monthly_39900
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# Number of monthly billing cycles (120 = 10 years). Required because
# perpetual subscriptions are not enabled on all Razorpay accounts.
RAZORPAY_TOTAL_COUNT=120

# --- Engine latency tuning (all optional) ---
# Cap each Stockfish search by depth and wall-clock seconds. The time limit is
# the safety net on slow hosts; the depth limit is the quality target.
# STOCKFISH_DEPTH=12
# STOCKFISH_TIME=0.2
# Number of parallel Stockfish processes used to score positions. 1 is best on
# hosts with <=1 CPU; raise it on multi-core machines.
# STOCKFISH_WORKERS=1
# Intermezzo/blind-spot diagnostics get their own (stricter) budget.
# STOCKFISH_DIAGNOSTIC_DEPTH=16
# STOCKFISH_DIAGNOSTIC_TIME=0.3
# Reuse Lichess server evaluations to skip re-analyzing annotated games.
# STOCKFISH_EVAL_REUSE=1
# STOCKFISH_EVAL_REUSE_COVERAGE=0.9
# Optional Gemini thinking budget override (unset = provider default).
# GEMINI_THINKING_BUDGET=0
